<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette: the iOS light system colors. -->
    <SolidColorBrush x:Key="IosBlue" Color="#007AFF"/>
    <SolidColorBrush x:Key="IosBlueTint" Color="#1F007AFF"/>
    <SolidColorBrush x:Key="IosRed" Color="#FF3B30"/>
    <SolidColorBrush x:Key="IosGreen" Color="#34C759"/>
    <SolidColorBrush x:Key="IosLabel" Color="#1C1C1E"/>
    <SolidColorBrush x:Key="IosSecondaryLabel" Color="#8E8E93"/>
    <SolidColorBrush x:Key="IosFill" Color="#F2F2F7"/>
    <SolidColorBrush x:Key="IosFillStrong" Color="#E5E5EA"/>
    <SolidColorBrush x:Key="IosSeparator" Color="#E5E5EA"/>
    <SolidColorBrush x:Key="IosCard" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="IosHairline" Color="#14000000"/>

    <FontFamily x:Key="IosFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="IosIconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Round icon button (toolbar). The background is the button's own, so a state can recolor it. -->
    <Style x:Key="IosCircleButton" TargetType="ButtonBase">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Background" Value="{StaticResource IosFill}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Shape" Background="{TemplateBinding Background}" CornerRadius="18">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shape" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Shape" Property="Opacity" Value="0.5"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Shape" Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Round icon toggle (toolbar): gray glyph when off, blue glyph on a blue tint when on. -->
    <Style x:Key="IosIconToggle" TargetType="ToggleButton" BasedOn="{StaticResource IosCircleButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource IosSecondaryLabel}"/>
        <Setter Property="FontFamily" Value="{StaticResource IosIconFont}"/>
        <Setter Property="FontSize" Value="16"/>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource IosBlueTint}"/>
                <Setter Property="Foreground" Value="{StaticResource IosBlue}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Borderless text button, like the "Done" of a navigation bar. -->
    <Style x:Key="IosTextButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource IosBlue}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Shape" Background="Transparent" Padding="6,4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shape" Property="Opacity" Value="0.7"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Shape" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Filled pill showing a value that can be changed by clicking it (shortcut fields). -->
    <Style x:Key="IosPillButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource IosFill}"/>
        <Setter Property="Foreground" Value="{StaticResource IosLabel}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="MinWidth" Value="96"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Shape" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,5"
                            BorderThickness="1.5" BorderBrush="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shape" Property="Background" Value="{StaticResource IosFillStrong}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Shape" Property="BorderBrush" Value="{StaticResource IosBlue}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Filled, borderless text field. -->
    <Style x:Key="IosTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource IosFill}"/>
        <Setter Property="Foreground" Value="{StaticResource IosLabel}"/>
        <Setter Property="CaretBrush" Value="{StaticResource IosBlue}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource IosBlue}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Shape" Background="{TemplateBinding Background}" CornerRadius="8" Padding="6,5"
                            BorderThickness="1.5" BorderBrush="Transparent">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Shape" Property="BorderBrush" Value="{StaticResource IosBlue}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Shape" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The iOS on/off switch. -->
    <Style x:Key="IosSwitch" TargetType="ToggleButton">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Track" Background="#E9E9EA" CornerRadius="14"/>
                        <Ellipse x:Name="Thumb" Width="24" Height="24" Fill="White" HorizontalAlignment="Left" Margin="2,0">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.25"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource IosGreen}"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Context menu: a floating rounded card; label on the left, icon (the item's Tag) on the right. -->
    <Style x:Key="IosMenuSeparator" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="0,5" Background="{StaticResource IosSeparator}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IosMenuItem" TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="{StaticResource IosLabel}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Row" Background="Transparent" CornerRadius="8" Height="34" Margin="5,0" Padding="11,0"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            <TextBlock Grid.Column="1" Text="{TemplateBinding Tag}" FontFamily="{StaticResource IosIconFont}"
                                       FontSize="14" Margin="28,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource IosFill}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Row" Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IosContextMenu" TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="FontFamily" Value="{StaticResource IosFont}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Margin="14" Padding="0,5" MinWidth="200" CornerRadius="14"
                            Background="{StaticResource IosCard}" BorderBrush="{StaticResource IosHairline}" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.22"/>
                        </Border.Effect>
                        <StackPanel IsItemsHost="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
