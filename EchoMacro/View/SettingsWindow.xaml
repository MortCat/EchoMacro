<Window x:Class="EchoMacro.View.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Settings" Width="412" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        FontFamily="{StaticResource IosFont}" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource IosSecondaryLabel}"/>
            <Setter Property="Margin" Value="14,18,14,6"/>
        </Style>
        <Style x:Key="SectionFooter" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource IosSecondaryLabel}"/>
            <Setter Property="Margin" Value="14,6,14,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource IosCard}"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Margin" Value="14,0"/>
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource IosLabel}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RowDetail" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource IosSecondaryLabel}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="RowSeparator" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="14,0,0,0"/>
            <Setter Property="Background" Value="{StaticResource IosSeparator}"/>
        </Style>
    </Window.Resources>

    <Border Margin="18" CornerRadius="18" Background="{StaticResource IosFill}"
            BorderBrush="{StaticResource IosHairline}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="5" Direction="270" Opacity="0.25"/>
        </Border.Effect>

        <StackPanel Margin="14,0,14,16">

            <!-- Navigation bar; dragging it moves the window. -->
            <Grid Height="50" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Button Content="Cancel" Style="{StaticResource IosTextButton}" HorizontalAlignment="Left" Click="Cancel_Click" IsCancel="True"/>
                <TextBlock Text="Settings" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource IosLabel}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button Content="Done" Style="{StaticResource IosTextButton}" FontWeight="SemiBold" HorizontalAlignment="Right" Click="Done_Click"/>
            </Grid>

            <TextBlock Text="SHORTCUTS" Style="{StaticResource SectionHeader}" Margin="14,4,14,6"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="Record / Stop" Style="{StaticResource RowLabel}"/>
                        <Button x:Name="btnRecordHotKey" Style="{StaticResource IosPillButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Click="HotKeyButton_Click" PreviewKeyDown="HotKeyButton_PreviewKeyDown" LostKeyboardFocus="HotKeyButton_LostKeyboardFocus"/>
                    </Grid>
                    <Border Style="{StaticResource RowSeparator}"/>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="Play / Stop" Style="{StaticResource RowLabel}"/>
                        <Button x:Name="btnPlayHotKey" Style="{StaticResource IosPillButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Click="HotKeyButton_Click" PreviewKeyDown="HotKeyButton_PreviewKeyDown" LostKeyboardFocus="HotKeyButton_LostKeyboardFocus"/>
                    </Grid>
                    <Border Style="{StaticResource RowSeparator}"/>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="Close EchoMacro" Style="{StaticResource RowLabel}"/>
                        <Button x:Name="btnCloseHotKey" Style="{StaticResource IosPillButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Click="HotKeyButton_Click" PreviewKeyDown="HotKeyButton_PreviewKeyDown" LostKeyboardFocus="HotKeyButton_LostKeyboardFocus"/>
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock Text="Click a shortcut, then press the new key combination." Style="{StaticResource SectionFooter}"/>

            <TextBlock Text="FOLDERS" Style="{StaticResource SectionHeader}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource Row}" MinHeight="54">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Recordings" Style="{StaticResource RowLabel}"/>
                            <TextBlock x:Name="txtRecordingsFolder" Style="{StaticResource RowDetail}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,-6,0">
                            <Button Content="Open" Style="{StaticResource IosTextButton}" Click="OpenRecordingsFolder_Click"/>
                            <Button Content="Change" Style="{StaticResource IosTextButton}" Click="ChangeRecordingsFolder_Click"/>
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource RowSeparator}"/>
                    <Grid Style="{StaticResource Row}" MinHeight="54">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Backups" Style="{StaticResource RowLabel}"/>
                            <TextBlock x:Name="txtBackupFolder" Style="{StaticResource RowDetail}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,-6,0">
                            <Button Content="Open" Style="{StaticResource IosTextButton}" Click="OpenBackupFolder_Click"/>
                            <Button Content="Change" Style="{StaticResource IosTextButton}" Click="ChangeBackupFolder_Click"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock Text="Recordings is where Load and Save As start. Unsaved recordings are copied to Backups automatically."
                       Style="{StaticResource SectionFooter}"/>

            <TextBlock Text="PLAYBACK" Style="{StaticResource SectionHeader}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="Stop when I move the mouse" Style="{StaticResource RowLabel}"/>
                        <ToggleButton x:Name="swAutoStop" Style="{StaticResource IosSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Border Style="{StaticResource RowSeparator}"/>
                    <Grid Style="{StaticResource Row}">
                        <TextBlock Text="After moving for" Style="{StaticResource RowLabel}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBox x:Name="txtAutoStopSeconds" Style="{StaticResource IosTextBox}" Width="50" Height="28" MaxLength="4"
                                     IsEnabled="{Binding IsChecked, ElementName=swAutoStop}"/>
                            <TextBlock Text="seconds" Style="{StaticResource RowLabel}" Foreground="{StaticResource IosSecondaryLabel}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock Text="The wait keeps an accidental bump of the mouse from interrupting playback."
                       Style="{StaticResource SectionFooter}"/>

            <TextBlock x:Name="txtError" FontSize="12" Foreground="{StaticResource IosRed}" TextWrapping="Wrap"
                       Margin="14,14,14,0" Visibility="Collapsed"/>
        </StackPanel>
    </Border>
</Window>
