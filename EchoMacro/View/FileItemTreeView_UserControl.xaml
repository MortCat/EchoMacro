<UserControl x:Class="EchoMacro.View.FileTreeView_UserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Each item's Tag is its icon glyph, drawn on the right by the menu item style. -->
    <UserControl.ContextMenu>
        <ContextMenu Style="{StaticResource IosContextMenu}">
            <ContextMenu.Resources>
                <Style TargetType="MenuItem" BasedOn="{StaticResource IosMenuItem}"/>
                <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator" BasedOn="{StaticResource IosMenuSeparator}"/>
            </ContextMenu.Resources>

            <MenuItem Header="Load Record" Tag="&#xE8E5;" Click="LoadRecord_Click"/>
            <MenuItem Header="Save As…" Tag="&#xE792;" Click="SaveAsRecord_Click"/>
            <MenuItem Header="Save" Tag="&#xE74E;" Click="SaveRecord_Click" IsEnabled="False" Name="SaveRecord"/>
            <Separator/>
            <MenuItem Header="Settings" Tag="&#xE713;" Click="Settings_Click"/>
            <Separator/>
            <MenuItem Header="Minimize" Tag="&#xE921;" Click="Minimize_Click"/>
            <MenuItem Header="Close" Tag="&#xE8BB;" Click="Close_Click" Foreground="{StaticResource IosRed}"/>
        </ContextMenu>
    </UserControl.ContextMenu>

</UserControl>
